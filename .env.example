# Docker Compose reads this file when you copy it to .env.

# Compose project name. Pinned so Docker volume names stay stable regardless of
# the folder the repository is checked out into. Changing it after the first
# `docker compose up` points Compose at different volumes, and the local
# WordPress database will appear empty.
COMPOSE_PROJECT_NAME=next-headless-wp-starter

WORDPRESS_DB_HOST=mysql:3306
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
# Local development placeholder. Change this before using the environment in production.
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_DB_ROOT_PASSWORD=change-me
